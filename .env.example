# Contact form (Nodemailer SMTP) — copy the needed lines into .env.local
# for local dev, and set the same variables in the Vercel project settings.
# For Gmail: enable 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
# NEVER put real credentials in this file.
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
# Optional — defaults shown:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_TO=you@gmail.com

# Blog (MongoDB Atlas) — required for the blog pages and for
# `npm run blog:publish` to work. Cover images are copied into public/blog/
# by the publish script, not uploaded anywhere — no extra credentials needed
# for that part. NEVER put real credentials in this file.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/
# Optional — defaults to "portfolio":
# MONGODB_DB=portfolio

# Used by the publish/unpublish scripts to trigger instant revalidation of
# the live site after a Mongo write. Optional — without these, new/edited
# posts still show up, just on the next ISR revalidate cycle instead of
# immediately. Set REVALIDATE_SECRET to any random string, in both
# .env.local and Vercel's project env vars.
# SITE_URL=https://your-site.vercel.app
# REVALIDATE_SECRET=a-long-random-string
